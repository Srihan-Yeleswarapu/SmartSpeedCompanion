<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        CFBundleShortVersionString and CFBundleVersion MUST live here as
        (MARKETING_VERSION) / (CURRENT_PROJECT_VERSION) build-setting
        variables — at the very TOP of the plist before any other key — so
        Xcode's variable substitution engine finds them during INFOPLIST_FILE
        processing. App Store Connect ingests the .ipa by reading these
        two keys verbatim from the compiled Info.plist; a stale or missing
        pair causes ALT to fall back to a previously cached version number
        (we hit this on the 1.1 rollout — altool raised 90478 "Invalid
        Version 2.1.4, later version closed" because the missing keys led
        to a baked value of "2.1.4" from a prior archive). XcodeGen also
        mirrors these two keys via project.yml's `info.properties` block,
        so the values stay in sync with the build-settings layer.
    -->
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <true/>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Speed Sense needs constant background location access to monitor speed and provide CarPlay navigation alerts even when the app is backgrounded.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>We need your location to show current speed in the dashboard.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>location</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>
        <!--
      CPSupportedTemplates for PLAN B (carplay-driving-task only).
      CPMapTemplate / CPNavigationAlert / CPSearchTemplate are removed
      because they require the carplay-navigation entitlement which is
      not yet available in the provisioning profile. Once the profile is
      regenerated, switch back to CarPlaySceneDelegate (Plan A) and
      restore the full template set.
    -->
    <key>CPSupportedTemplates</key>
    <array>
        <string>CPListTemplate</string>
        <string>CPAlertTemplate</string>
        <string>CPInformationTemplate</string>
        <string>CPNowPlayingTemplate</string>
    </array>
    <key>NSMotionUsageDescription</key>
    <string>We use motion data for advanced crash detection during drive sessions.</string>
    <key>NSSiriUsageDescription</key>
    <string>Siri integration allows you to start and end drives, check your current speed, the posted speed limit, the time until your next turn, your estimated arrival time, and the remaining distance to your destination via voice controls.</string>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>CPTemplateApplicationSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>CPTemplateApplicationScene</string>
                                        <!-- Plan B: CarPlaySceneDelegateB uses list-only templates.
                         Switch to CarPlaySceneDelegate when provisioning profile
                         authorizes carplay-navigation. -->
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegateB</string>
                </dict>
            </array>
            <key>CPTemplateApplicationDashboardSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>CPTemplateApplicationDashboardScene</string>
                    <!-- Plan B: same delegate handles dashboard with list-safe APIs -->
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegateB</string>
                </dict>
            </array>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>NSSupportsLiveActivities</key>
    <true/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>