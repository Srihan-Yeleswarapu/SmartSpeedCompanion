<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      NOTE 2026-08-02 — CarPlay Audio App capability GRANTED.
      The CarPlay Audio App (CarPlay framework) entitlement
      (`com.apple.developer.carplay-audio`) has been assigned to this
      account, unlocking first-class audio for Speedio on CarPlay:
      a stable AVAudioSession that routes through the car's dedicated
      navigation-voice channel (separate volume control, lower latency),
      background audio while connected, and the Now Playing template
      (CPNowPlayingTemplate) that the audio-app category requires.

      ACTION REQUIRED: re-download the "Speedio App Store" provisioning
      profile from developer.apple.com → Certificates, Identifiers &
      Profiles → Profiles after enabling CarPlay Audio App on App ID
      `com.speedsense.app`, then re-encode the
      APPSTORE_PROVISIONING_PROFILE_BASE64 GitHub secret (and the local
      Speedio_App_Store.mobileprovision). Building with this entitlement
      before the profile is regenerated will fail codesign.

      The legacy `carplay-navigation` key is intentionally absent —
      navigation capability ships via the consolidated
      `com.apple.developer.carplay-maps` key Apple now issues for
      approved CarPlay navigation apps.
    -->
    <key>com.apple.developer.carplay-driving-task</key>
    <true/>
    <key>com.apple.developer.carplay-maps</key>
    <true/>
    <key>com.apple.developer.carplay-audio</key>
    <true/>
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)com.speedsense.app</string>
    </array>
    <!--
      App Group capability is now REQUIRED so the widget extension can
      read the same `group.com.smartspeedcompanion.app` defaults that
      `SpeedFormatting.writeMeasurementSystemToAppGroup(_:)` and
      `DriveViewModel.writeWidgetSnapshot()` write. Without this entry
      the App Store provisioning profile rejects the entitlement file at
      sign time and the widget binary never ships to TestFlight.
      MANUAL SETUP NOTE: enable the App Group on App ID
      `com.speedsense.app` at developer.apple.com and re-download the
      `Speedio App Store` provisioning profile.
    -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.smartspeedcompanion.app</string>
    </array>
</dict>
</plist>
