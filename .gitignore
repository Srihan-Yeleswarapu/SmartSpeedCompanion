# App-level secrets (gitignored; use .example template for reference)
SmartSpeedCompanion/Configuration/HERE-Config.plist

# Xcode project file generated by XcodeGen (regenerated from project.yml)
/SmartSpeedCompanion.xcodeproj

# Xcode user data
*.xcuserdata

# Build products
.build/
DerivedData/

# Build/CI logs
.buildlogs/
GitHubAction Error Logs/
*_failure.log
ci_*.log

# Python cache
__pycache__/
*.pyc

# macOS junk
.DS_Store

# Tooling internal data
.agents/
.freebuff/

# Random junk files (often created by accidental redirection)
nul

# Large binary data files
*.geodatabase

# Personal images
*.jpeg
*.jpg
